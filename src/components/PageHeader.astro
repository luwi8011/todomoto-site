---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, image, imageAlt = '' } = Astro.props;
---

<section class="border-b border-line">
  <div class:list={['mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:py-16', image && 'lg:grid-cols-[1.1fr_1fr] lg:items-center']}>
    <div>
      {Astro.slots.has('eyebrow') && <div class="mb-3 text-muted"><slot name="eyebrow" /></div>}
      <h1 class="font-display text-4xl leading-tight text-flame sm:text-6xl">{title}</h1>
      <div class="mt-5 max-w-2xl text-lg"><slot /></div>
    </div>
    {
      image && (
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full rounded-lg object-cover"
        />
      )
    }
  </div>
</section>
