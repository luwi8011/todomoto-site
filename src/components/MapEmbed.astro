---
// Google Maps loads only after a click: no third-party requests or cookies on page load.
import { addressLine, directionsHref } from '../lib/site';

const src = `https://maps.google.com/maps?q=${encodeURIComponent(addressLine)}&z=15&output=embed`;
---

<div class="map-embed relative aspect-[4/3] overflow-hidden rounded-lg border border-line bg-ink" data-src={src}>
  <div class="grid size-full place-items-center p-6 text-center">
    <div>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="mx-auto size-10 fill-flame"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" /></svg>
      <p class="mt-3">{addressLine}</p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <button type="button" class="rounded-md border-2 border-cream/80 px-4 py-2 font-bold hover:bg-cream hover:text-ink">Show map</button>
        <a href={directionsHref} class="rounded-md bg-brand px-4 py-2 font-bold ring-1 ring-flame/35 hover:bg-brand-hover">Get directions</a>
      </div>
    </div>
  </div>
</div>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('.map-embed')) {
    el.querySelector('button')?.addEventListener(
      'click',
      () => {
        const frame = document.createElement('iframe');
        frame.src = el.dataset.src!;
        frame.title = 'Map showing the Todo Moto shop location';
        frame.className = 'size-full border-0';
        frame.referrerPolicy = 'no-referrer-when-downgrade';
        el.replaceChildren(frame);
      },
      { once: true },
    );
  }
</script>
