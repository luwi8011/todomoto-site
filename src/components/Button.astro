---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
};

const { variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;

const variants = {
  primary: 'bg-brand text-cream ring-1 ring-flame/35 hover:bg-brand-hover',
  secondary: 'border-2 border-cream/80 text-cream hover:bg-cream hover:text-ink',
  ghost: 'text-flame underline underline-offset-4 hover:text-cream',
};
const sizes = { md: 'px-5 py-2.5 text-base', lg: 'px-7 py-3.5 text-lg' };
---

<a
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-md font-bold transition-colors',
    variants[variant],
    variant !== 'ghost' && sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
