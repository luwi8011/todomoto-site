---
import { getEntry, render } from 'astro:content';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Hours from '../components/Hours.astro';
import MapEmbed from '../components/MapEmbed.astro';
import ContactForm from '../components/ContactForm';
import { site, telHref, mailHref, laborRateLabel } from '../lib/site';

const page = await getEntry('pages', 'contact-us');
if (!page) throw new Error('src/content/pages/contact-us.md is missing');
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description}>
  <PageHeader title={page.data.heading ?? page.data.title}>
    <div class="prose-shop"><Content /></div>
    <p class="mt-4 text-2xl font-bold"><a href={telHref} class="text-flame underline">{site.phone}</a></p>
  </PageHeader>

  <div class="mx-auto mt-12 grid max-w-6xl gap-10 px-4 lg:grid-cols-[1fr_24rem]">
    <section aria-labelledby="contact-form-heading">
      <h2 id="contact-form-heading" class="mb-4 text-2xl font-bold">Send us a message</h2>
      <ContactForm client:load siteKey={PUBLIC_TURNSTILE_SITE_KEY} phone={site.phone} phoneHref={telHref} />
      <noscript>
        <p class="mt-4 rounded-md border border-flame/60 p-4">The message form needs JavaScript. Call us at {site.phone} or email {site.email}.</p>
      </noscript>
    </section>

    <aside class="space-y-6">
      <div class="rounded-lg border border-line bg-surface p-6">
        <h2 class="text-xl font-bold">Visit the shop</h2>
        <address class="mt-3 not-italic">
          {site.address.street}<br />
          {site.address.city}, {site.address.region} {site.address.postalCode}
        </address>
        <p class="mt-3"><a href={mailHref} class="break-words hover:text-flame">{site.email}</a></p>
        <h3 class="mt-5 font-bold">Hours</h3>
        <Hours class="mt-2" />
        <p class="mt-5 text-muted">Labor rate {laborRateLabel}</p>
      </div>
      <MapEmbed />
    </aside>
  </div>
</Base>
