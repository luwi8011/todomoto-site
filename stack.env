# Settings for the self-hosted preview (Portainer stack). Change these, commit, and redeploy.

# Host port the site listens on. Nginx Proxy Manager forwards to <docker host IP>:PORT.
PORT=8085

# Public address of the preview (the Nginx Proxy Manager host). Used for share previews
# and canonical links; read at build time.
SITE_URL=https://todomoto.wilsonfabrication.com
